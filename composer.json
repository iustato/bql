{
    "name": "iustato/bql",
    "description": "interpreter for simple query language for php projects",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "iustato\\Bql\\": "src/"
        }
    },
    "authors": [
        {
            "name": "artiom.vasiliev",
            "email": "artem@bezdnanet.com"
        }
    ],
    "require": {
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "TestProj\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "test-debug": "XDEBUG_SESSION=1 phpunit tests",
        "test-simple": "phpunit tests/SimpleTest.php",
        "test-orders": "phpunit tests/OrderExpressionTest.php",
        "test-math": "phpunit tests/MathOperationsTest.php",
        "test-coverage": "phpunit --coverage-html coverage tests"
    }
}